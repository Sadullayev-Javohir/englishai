{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 7880,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Hello, this is 6 Minute English\nfrom BBC Learning English. I'm Neil."
    } ]
  }, {
    "tStartMs": 11720,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "And I'm Pippa."
    } ]
  }, {
    "tStartMs": 13080,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "In this episode\nwe're discussing poetry."
    } ]
  }, {
    "tStartMs": 16080,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "For some, poetry is what you study\nat school, then forget,"
    } ]
  }, {
    "tStartMs": 20080,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "while for others it becomes\nan important part of their life."
    } ]
  }, {
    "tStartMs": 23960,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Have you ever read\nor written any poetry, Neil?"
    } ]
  }, {
    "tStartMs": 27240,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Well, I haven't written any poetry\nsince I was at school."
    } ]
  }, {
    "tStartMs": 31080,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "I would love to read more poetry,\nbut I just don't get it, really."
    } ]
  }, {
    "tStartMs": 36440,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "I find it difficult to understand."
    } ]
  }, {
    "tStartMs": 38560,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "A good place to hear poetry\nis an open mic night, a live event"
    } ]
  }, {
    "tStartMs": 43000,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "where anyone is allowed to stand up\non stage to sing or recite poems."
    } ]
  }, {
    "tStartMs": 47720,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Here, BBC reporter Maria recites\nher open mic poem"
    } ]
  }, {
    "tStartMs": 51600,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "about a friend who suffered a stroke,"
    } ]
  }, {
    "tStartMs": 53480,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "for BBC World Service\nprogramme People Fixing the World."
    } ]
  }, {
    "tStartMs": 57040,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "This first poem, I wrote it\nabout a friend who I love dearly."
    } ]
  }, {
    "tStartMs": 60200,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "It's called Stroke."
    } ]
  }, {
    "tStartMs": 62400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "You're awake\nAnd trying to grasp who it is."
    } ]
  }, {
    "tStartMs": 65200,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "I pull my mask past my lips\nand you study my face,"
    } ]
  }, {
    "tStartMs": 68280,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Eyes wide."
    } ]
  }, {
    "tStartMs": 70520,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "I've enough stuff to tell you, I say,"
    } ]
  }, {
    "tStartMs": 73440,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Sinking into a chair."
    } ]
  }, {
    "tStartMs": 76280,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "I stare."
    } ]
  }, {
    "tStartMs": 77600,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Sometimes\nif you go to an open mic night,"
    } ]
  }, {
    "tStartMs": 79920,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "people can really touch your soul\nwith what they're saying."
    } ]
  }, {
    "tStartMs": 82920,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And even if you're having a bad day,\nlife can feel so much better"
    } ]
  }, {
    "tStartMs": 86160,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "after going to an open mic night."
    } ]
  }, {
    "tStartMs": 88120,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "For Maria, poetry has the power\nto heal emotions and touch your soul,"
    } ]
  }, {
    "tStartMs": 92920,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "meaning to affect you deeply\non an emotional or spiritual level."
    } ]
  }, {
    "tStartMs": 97280,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "In this episode, we'll hear more\nabout the positive power of poetry and,"
    } ]
  }, {
    "tStartMs": 102120,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "as usual, we'll learn\nsome useful new words and phrases."
    } ]
  }, {
    "tStartMs": 105480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And remember,\nyou'll find all the vocabulary,"
    } ]
  }, {
    "tStartMs": 108280,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "plus a quiz and worksheet on\nour website, bbclearningenglish.com."
    } ]
  }, {
    "tStartMs": 112920,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "But first,\nI have a question for you, Pippa."
    } ]
  }, {
    "tStartMs": 115880,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Just now you used the phrase\n'the positive power of poetry',"
    } ]
  }, {
    "tStartMs": 120000,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "repeating the same initial 'p' sound\nacross a string of words."
    } ]
  }, {
    "tStartMs": 125400,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Doing this is a common feature\nof poetry, but what's it called?"
    } ]
  }, {
    "tStartMs": 129520,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Is it: a) assonance, b) alliteration,\nor c) simile?"
    } ]
  }, {
    "tStartMs": 135520,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Hmm. Finally, my\nEnglish degree might come in handy!"
    } ]
  }, {
    "tStartMs": 138560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And I'm going to say b) alliteration."
    } ]
  }, {
    "tStartMs": 141040,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "Well, we'll find out at the end, and\nI hope you don't get embarrassed, Pippa!"
    } ]
  }, {
    "tStartMs": 145760,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Now, poetry helped\nMaria overcome sadness,"
    } ]
  }, {
    "tStartMs": 149040,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "but could its power to heal work\nin other areas too?"
    } ]
  }, {
    "tStartMs": 153320,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Hot Poets is a group helping\npeople understand the science"
    } ]
  }, {
    "tStartMs": 156960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "behind global issues\nlike climate change."
    } ]
  }, {
    "tStartMs": 159360,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "They go to meetings\nlike the UN Climate Conference"
    } ]
  }, {
    "tStartMs": 162040,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and listen\nto scientific papers being presented."
    } ]
  }, {
    "tStartMs": 164800,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "Then they write a poem about it all\nand perform that back to the audience."
    } ]
  }, {
    "tStartMs": 169760,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Here's Hot Poet Liv Torc,\nreciting her poem"
    } ]
  }, {
    "tStartMs": 172760,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "to BBC World Service's People Fixing\nthe World."
    } ]
  }, {
    "tStartMs": 176120,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "It starts with an adventure at sea,"
    } ]
  }, {
    "tStartMs": 179480,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "A big blue murder mystery,\nwhere the killer is not the whale"
    } ]
  }, {
    "tStartMs": 183680,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "But an epic humanity fail"
    } ]
  }, {
    "tStartMs": 185320,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "Of overfishing\nand polluting at unimaginable scale."
    } ]
  }, {
    "tStartMs": 191560,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Liv's poem is based\non a study into biodiversity."
    } ]
  }, {
    "tStartMs": 195360,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "It's a complex research project\nthat many find hard to understand."
    } ]
  }, {
    "tStartMs": 199880,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Here, Liv discusses this"
    } ]
  }, {
    "tStartMs": 201200,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "with Myra Anubi for BBC World Service\nprogramme People Fixing the World:"
    } ]
  }, {
    "tStartMs": 206000,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "And Liv, I mean, so what you've\nidentified is that there is an issue"
    } ]
  }, {
    "tStartMs": 210040,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "around the communication of science."
    } ]
  }, {
    "tStartMs": 212920,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Yes, a lot of this jargon\nis really hard to understand,"
    } ]
  }, {
    "tStartMs": 216400,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "or a lot of the science is\nquite impenetrable to normal people,"
    } ]
  }, {
    "tStartMs": 219280,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "so it's instantly a turn-off."
    } ]
  }, {
    "tStartMs": 221240,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Science uses lots of jargon –\nspecialist or technical vocabulary"
    } ]
  }, {
    "tStartMs": 225680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "which is quite different\nfrom everyday language."
    } ]
  }, {
    "tStartMs": 228240,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "For example, a scientist might use\nthe word precipitation,"
    } ]
  }, {
    "tStartMs": 232080,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "while in everyday English\nwe would say rain."
    } ]
  }, {
    "tStartMs": 235480,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Jargon can make\nscientific papers impenetrable,"
    } ]
  }, {
    "tStartMs": 238760,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "an adjective meaning impossible\nto understand."
    } ]
  }, {
    "tStartMs": 241920,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "And worse,\nit makes science a turn-off –"
    } ]
  }, {
    "tStartMs": 244760,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "something that people dislike\nor find uninteresting."
    } ]
  }, {
    "tStartMs": 247960,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Hot Poets try to change all of that"
    } ]
  }, {
    "tStartMs": 249960,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "by making complex environmental ideas\neasy to understand through poetry."
    } ]
  }, {
    "tStartMs": 254520,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "And it works, says Kat Bruce,"
    } ]
  }, {
    "tStartMs": 256880,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "the environmental scientist\nwhose study Liv based her poem on,"
    } ]
  }, {
    "tStartMs": 261120,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "talking here with Myra Anubi for BBC\nWorld Service's People Fixing the World."
    } ]
  }, {
    "tStartMs": 265840,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "What did it mean for you, Kat,"
    } ]
  }, {
    "tStartMs": 267560,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "hearing the poem, having actually\nexperienced everything she's saying?"
    } ]
  }, {
    "tStartMs": 271640,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "It still gives me goosebumps\nwhen I hear it now."
    } ]
  }, {
    "tStartMs": 275120,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "I think it's everything that I wish I\ncould say and put into words myself."
    } ]
  }, {
    "tStartMs": 281280,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "I feel like Liv just,\nyou know, has done that."
    } ]
  }, {
    "tStartMs": 284720,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Liv's poem gave Kat goosebumps,\nmeaning she was so emotionally affected"
    } ]
  }, {
    "tStartMs": 289600,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "that the hairs on her skin stood up,\nmaking tiny bumps."
    } ]
  }, {
    "tStartMs": 293560,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Maybe poetry can't fix everything,"
    } ]
  }, {
    "tStartMs": 295440,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "but for Kat,\nit's making an impact for good."
    } ]
  }, {
    "tStartMs": 298120,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Now, what was the answer\nto your question, Neil?"
    } ]
  }, {
    "tStartMs": 300760,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Well, you seemed very clear, Pippa,"
    } ]
  }, {
    "tStartMs": 303760,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "that when you use a string of\nwords beginning with the same sound,"
    } ]
  }, {
    "tStartMs": 307680,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "it's called alliteration..."
    } ]
  }, {
    "tStartMs": 309600,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and you're absolutely right."
    } ]
  }, {
    "tStartMs": 312520,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Phew!"
    } ]
  }, {
    "tStartMs": 313800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "OK. Let's recap\nthe vocabulary we've learned,"
    } ]
  }, {
    "tStartMs": 316680,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "starting with open mic night,"
    } ]
  }, {
    "tStartMs": 318960,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "a live event where anyone is allowed\nto perform poems or music on stage."
    } ]
  }, {
    "tStartMs": 323560,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "If something touches your soul,\nit affects you deeply"
    } ]
  }, {
    "tStartMs": 327000,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "on an emotional or spiritual level."
    } ]
  }, {
    "tStartMs": 329440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Jargon means special words\nand phrases"
    } ]
  }, {
    "tStartMs": 331680,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that are used in a particular\nprofession or subject."
    } ]
  }, {
    "tStartMs": 334680,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "The adjective impenetrable means\nimpossible to understand."
    } ]
  }, {
    "tStartMs": 338520,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "A turn-off is something that\npeople dislike or find uninteresting."
    } ]
  }, {
    "tStartMs": 342640,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "And finally, if you get goosebumps,\nthe hairs on your skin stand up"
    } ]
  }, {
    "tStartMs": 347040,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "because you're cold,\nemotionally affected, or afraid."
    } ]
  }, {
    "tStartMs": 351000,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Once again, our six minutes are up,"
    } ]
  }, {
    "tStartMs": 353320,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "but remember, you'll find lots more\nepisodes as well as a quiz and worksheet"
    } ]
  }, {
    "tStartMs": 357800,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "for this one on our website,\nbbclearningenglish.com."
    } ]
  }, {
    "tStartMs": 362000,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "See you again soon."
    } ]
  }, {
    "tStartMs": 363080,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "But for now it's goodbye."
    } ]
  }, {
    "tStartMs": 364520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Goodbye!"
    } ]
  } ]
}
