{
  "name": "englishai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:seo": "node scripts/generate-seo.mjs",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "build": "npm run generate:seo && tsc -b && vite build && npm run prerender",
    "prerender": "vite build --ssr src/entry-prerender.tsx --outDir .prerender --emptyOutDir && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ignore-pattern 'public/vendor/**/*' --ignore-pattern 'src/vendor/**/*'",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e:cross-browser": "PW_CROSS_BROWSER=1 playwright test",
    "test:audit": "npm test && npm run lint -- --max-warnings=0 && npm run build && npm run test:e2e",
    "build:mobile": "VITE_API_BASE_URL=https://englishai.uz tsc -b && VITE_API_BASE_URL=https://englishai.uz vite build && cap sync",
    "android:open": "cap open android",
    "android:apk": "test -f android/keystore.properties || (echo 'Release keystore is required.' >&2; exit 1); cd android && ./gradlew assembleRelease",
    "android:aab": "test -f android/keystore.properties || (echo 'Release keystore is required.' >&2; exit 1); cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.3.30",
    "@microsoft/signalr": "^8.0.7",
    "@ricky0123/vad-web": "^0.0.30",
    "chart.js": "^4.5.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.24.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@capacitor/android": "^8.4.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^3.2.7"
  }
}
