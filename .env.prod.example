# EnglishAI.uz production environment - copy to `.env` ON THE SERVER and fill in.
# NEVER commit the real `.env` (it is git-ignored). Keep these values in a secret store.

# ---- deployment / images ----
# GHCR owner = your GitHub username or org (lowercase), e.g. javohir.
GHCR_OWNER=your-github-username
# Full 40-character commit SHA only. Keep the four values together from the
# signed release manifest; never point production Compose at `latest`.
BACKEND_IMAGE_SHA=0000000000000000000000000000000000000000
FRONTEND_IMAGE_SHA=0000000000000000000000000000000000000000
WORKER_IMAGE_SHA=0000000000000000000000000000000000000000
TRANSCRIPT_IMAGE_SHA=0000000000000000000000000000000000000000
APP_DRAIN_SECONDS=120
WORKER_DRAIN_SECONDS=300
TRANSCRIPT_DRAIN_SECONDS=30

# ---- domain / TLS ----
DOMAIN=englishai.uz
ACME_EMAIL=javohirsadullayev836@gmail.com

# ---- database ----
POSTGRES_USER=englishai
POSTGRES_DB=englishai
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_DB_CONTEXT_POOL_SIZE=24
POSTGRES_SERVER_CONNECTION_BUDGET=24
BACKEND_HANGFIRE_DB_BUDGET=8
CRITICAL_WORKER_DB_CONTEXT_POOL_SIZE=4
HANGFIRE_CRITICAL_DB_BUDGET=8
GENERAL_WORKER_DB_CONTEXT_POOL_SIZE=8
HANGFIRE_GENERAL_DB_BUDGET=16
DATABASE_MIGRATION_LOCK_TIMEOUT_SECONDS=300

# ---- auth ----
# Google OAuth web client id (same value used for the frontend build VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
# Long random secret for signing session JWTs (>= 32 chars). Generate: openssl rand -base64 48
JWT_SIGNING_KEY=
# Single-VPS production uses the private Compose Redis service. Redis Sentinel
# credentials belong to the separate HA deployment and are not required here.
OBJECT_STORAGE_SERVICE_URL=https://fsn1.your-objectstorage.com
OBJECT_STORAGE_REGION=fsn1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BUCKET=englishai-public
OBJECT_STORAGE_PRIVATE_BUCKET=englishai-private
OBJECT_STORAGE_PUBLIC_BASE_URL=https://englishai-public.fsn1.your-objectstorage.com
OBJECT_STORAGE_KEY_PREFIX=englishai
# Data Protection keys persist in a Docker volume. Deploy creates the password-protected
# ./secrets/data-protection/keys.pfx certificate when it is missing. Generate: openssl rand -base64 48
DATA_PROTECTION_CERTIFICATE_PASSWORD=

# ---- AI / speech / content providers ----
# Hermes Agent Gateway is the primary internal LLM API for Speaking, Writing, Video and all other
# text-intelligence features. Generate a long random API key (>= 32 chars); it is shared only by the
# backend and the private Hermes container, never by browsers.
HERMES_GATEWAY_API_KEY=
# Public model alias exposed by Hermes and used by the backend. The upstream model is Hermes' own
# configured provider/model selection.
HERMES_API_MODEL=hermes-agent
HERMES_UPSTREAM_MODEL=stepfun/step-3.7-flash:free
# Pin this to a tested Hermes image tag or digest in production instead of relying on `latest`.
HERMES_IMAGE=nousresearch/hermes-agent:latest
# Container safety rails. Tune only after observing `docker stats englishai-hermes-agent`.
HERMES_CPUS=1.50
# Two agents run, so this is doubled on the host — the single largest memory exposure on the box.
# Steady-state usage is ~240 MiB each; 1536m leaves generous headroom without risking the host.
HERMES_MEMORY_LIMIT=1536m
HERMES_MEMORY_RESERVATION=512m
HERMES_PIDS_LIMIT=256
HERMES_LOG_MAX_SIZE=20m
HERMES_LOG_MAX_FILES=5
# Log rotation for every other container. Without these the json-file driver is unbounded and a
# long-lived deployment fills the disk. Worst case with the defaults: 12 x 5 x 20m ~= 1.2 GiB.
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5
# Hermes 2 autoscaler: wake the standby when Hermes 1 is unhealthy, CPU reaches 35%, or memory
# usage reaches 1.4 GiB. Stop it after 15 minutes without another threshold breach.
HERMES_SCALE_CPU_PERCENT=35
HERMES_SCALE_MEMORY_BYTES=1503238554
HERMES_SCALE_IDLE_SECONDS=900
# Hermes upstream provider credential. The container uses this server-side; EnglishAI's public
# eai_* API keys never expose it. A Nous Portal API key/token is the recommended default.
DEVELOPER_AI_API_KEY_1=
DEVELOPER_AI_API_KEY_2=
HERMES_MAX_CONCURRENCY=32
HERMES_MAX_QUEUE_LENGTH=2000
HERMES_QUEUE_TIMEOUT_SECONDS=45
HERMES_REQUEST_TIMEOUT_SECONDS=90
HERMES_CIRCUIT_FAILURE_THRESHOLD=5
HERMES_CIRCUIT_BREAK_SECONDS=30
AI_GLOBAL_CONCURRENCY=32
AI_PRO_RESERVED_CONCURRENCY=8
AI_MAX_QUEUE_LENGTH=128
AI_QUEUE_TIMEOUT_SECONDS=15
AI_FREE_REQUESTS_PER_MINUTE=4
AI_PRO_REQUESTS_PER_MINUTE=12
AI_DAILY_BUDGET_USD=25
AI_BUDGET_WARNING_RATIO=0.8
# Per-learner daily ceilings. The global budget above is all-or-nothing: without these, one runaway
# account drains it and every other free learner is shed for the rest of the day. Checked before the
# global budget and for BOTH tiers. Set to 0 to disable (not recommended).
AI_FREE_DAILY_BUDGET_PER_LEARNER_USD=0.60
AI_PRO_DAILY_BUDGET_PER_LEARNER_USD=3.00
# Which features justify the paid primary model. Everything NOT listed here runs on the self-hosted
# Hermes gateway, which costs nothing per request. The speaking tutor is deliberately absent: it is
# capped at 96 output tokens and is by far the highest-volume caller, so paying primary rates for it
# was the single largest avoidable line on the AI bill. Comma-separated AiFeature names; an unknown
# name is ignored (that feature falls back to the budget model) rather than failing startup.
AI_ROUTING_PREMIUM_FEATURES=WritingAssessment,Assistant
# Rates for the primary LLM (SOL_PRIMARY_MODEL, currently gpt-5.6-sol). Requests that fall back
# to self-hosted Hermes cost nothing, and cached input is ~10x cheaper than the rate below, so
# these values over-estimate — the safe direction, matching the AzureSpeech convention.
# Keep in step with SOL_PRIMARY_MODEL: a model change is a pricing change.
AI_PRICING_CONFIGURED=true
AI_INPUT_COST_PER_MILLION_TOKENS_USD=5
AI_OUTPUT_COST_PER_MILLION_TOKENS_USD=30
# NOTE: GROQ_API_KEY / GOOGLE_AI_STUDIO_API_KEY / GEMINI_API_KEY / OPENROUTER_API_KEY were removed.
# docker-compose.prod.yml no longer passes them to any service, so keeping them here only left
# unused live credentials sitting on disk. Revoke any you previously deployed.
# Self-hosted speech-to-text sidecar for the FREE tier (services/speech-stt). Azure bills per audio
# hour, which the free cohort cannot pay for at any realistic conversion rate; free learners are
# transcribed on this VPS instead, while Premium keeps Azure (accented-speech accuracy and
# pronunciation scoring are what the subscription buys).
# LEAVE FALSE until you have measured latency on THIS box: base.en at 2 cores runs ~0.3-0.6x
# realtime, so a long turn adds seconds before the tutor even starts. With it false every learner
# keeps using Azure - costs money, but works.
WHISPER_ENABLED=false
SPEECH_STT_IMAGE_SHA=
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_THREADS=2
WHISPER_CPUS=2.00
WHISPER_MEMORY_LIMIT=1024m
WHISPER_TIMEOUT_SECONDS=30
# NOT the same scale as AzureSpeech MinimumRecognitionConfidence - this one comes from the decoder's
# average log-probability. Tune it separately against real learner audio.
WHISPER_MINIMUM_CONFIDENCE=0.25
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Pay-as-you-go estimates; verify against the Azure billing offer and region before release.
AZURE_SPEECH_PRICING_CONFIGURED=true
AZURE_SPEECH_STT_COST_PER_AUDIO_HOUR_USD=1.32
AZURE_SPEECH_TTS_COST_PER_MILLION_CHARACTERS_USD=16
AZURE_SPEECH_PRONUNCIATION_COST_PER_AUDIO_HOUR_USD=1.32
# Live Accent Tutor (4 aksent: American/British/Australian/Irish). These drive the Azure AI Foundry
# agent replies. Set ENABLED=true and provide the Foundry project endpoint plus an Entra ID
# service-principal (App Registration) that has an AI role — e.g. "Azure AI Developer" — on that
# project. Without these the tutor recognises speech but cannot reply (accent_tutor_authentication_failed).
AZURE_ACCENT_TUTORS_ENABLED=false
AZURE_ACCENT_TUTORS_ENDPOINT=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Realtime Voice Live cost governance. The browser streams audio straight to Azure, so the backend
# only sees the session start (token mint) and the completion report: it reserves
# RESERVATION_MINUTES up front and reconciles against the real duration when the client reports
# back. A session that never reports keeps the reservation — that is the intended failure mode.
# VERIFY the rate against the current Azure price sheet for the Voice Live agent SKU. The built-in
# fallback (30) is deliberately high so an unconfigured deployment over-charges rather than
# under-charges; it is never meant to be accurate.
AZURE_VOICE_LIVE_PRICING_CONFIGURED=true
AZURE_VOICE_LIVE_COST_PER_AUDIO_HOUR_USD=30
# Hard ceiling billed for one session, however long the tab stays open.
AZURE_VOICE_LIVE_MAX_SESSION_MINUTES=10
# Charged at token mint, refunded on completion. Keep small: the daily budget is global, so every
# un-reconciled reservation eats into the allowance shielding every other free user.
AZURE_VOICE_LIVE_RESERVATION_MINUTES=2
AZURE_VOICE_LIVE_DAILY_MINUTES_PER_LEARNER=30
YOUTUBE_API_KEY=
UNSPLASH_ACCESS_KEY=
IMAGE_MODERATION_IMAGE_SHA=
IMAGE_MODERATION_REQUIRE_APPROVAL=true
IMAGE_MODERATION_UNSAFE_THRESHOLD=0.20
IMAGE_MODERATION_TIMEOUT_SECONDS=20
# Supadata transcript API key (supadata.ai) - PRIMARY source for /video interactive transcripts.
# Without it the prod datacenter IP hits YouTube's bot wall and transcripts never load. Free signup.
SUPADATA_API_KEY=

# ---- admin ----
# Token guarding POST /api/admin/* (backfill, images). Generate: openssl rand -hex 24
BACKFILL_ADMIN_TOKEN=

# ---- rate limiting (perimeter DoS / brute-force shield) ----
# ON by default (appsettings.json) with safe, generous limits; real-time hubs, /health and
# audio/image streams are exempt. These are only needed to OVERRIDE the defaults. The KILL
# SWITCH is RateLimiting__Enabled=false - flip it (then `docker compose up -d backend`) if the
# limiter ever throttles a legitimate user; no code change / rebuild required.
# RateLimiting__Enabled=true
# RateLimiting__PermitPerMinute=300       # per user/IP, all non-auth endpoints
# RateLimiting__AuthPermitPerMinute=20    # tighter window for /api/auth (sign-in)
# RateLimiting__DeveloperPermitPerMinute=12 # per public developer API key/IP
# RateLimiting__TranslationPermitPerMinute=20 # on-demand translation requests per user/IP
# DeveloperAi__MaxRequestBytes=65536        # reject oversized prompt payloads
# DeveloperAi__MaxConcurrentRequests=4      # bound simultaneous Hermes proxy calls
# SPEAKING_LIVE_ENABLED=false                # SignalR + automatic VAD speaking beta
# DeveloperAi__RequestTimeoutSeconds=120    # cancel stuck upstream requests
# Regional payment providers. Keep payments disabled until merchant contracts and keys exist.
Subscription__PaymentsEnabled=false
# Learners who registered BEFORE checkout existed keep full access while payments are off, so
# shortening the trial to 7 days cannot strand the cohort the product already has. Set this to the
# deploy date (ISO 8601, e.g. 2026-08-16T00:00:00Z) - leaving it EMPTY disables the grant, and those
# learners drop to the free tier the day their old trial expires.
# It retires itself: the moment Subscription__PaymentsEnabled becomes true, the grant stops applying.
LEGACY_ACCESS_ACCOUNTS_CREATED_BEFORE=
Payments__MockMode=false
Payments__PublicBaseUrl=https://englishai.uz
Payments__WebhookBaseUrl=https://api.englishai.uz
Payments__Click__MerchantId=
Payments__Click__ServiceId=
Payments__Click__SecretKey=
Payments__Click__CheckoutUrl=
Payments__Payme__MerchantId=
Payments__Payme__ServiceId=
Payments__Payme__SecretKey=
Payments__Payme__CheckoutUrl=
Payments__Uzum__MerchantId=
Payments__Uzum__ServiceId=
Payments__Uzum__SecretKey=
Payments__Uzum__CheckoutUrl=
